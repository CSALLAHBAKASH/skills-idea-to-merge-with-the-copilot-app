---
---
<section class="manager" aria-label="Bookmark manager">
  <form id="add-bookmark">
    <div class="field">
      <label for="url">Link to save</label>
      <input
        id="url"
        name="url"
        type="text"
        inputmode="url"
        autocomplete="url"
        spellcheck="false"
        placeholder="example.com"
        required
      />
    </div>
    <button type="submit">Add bookmark</button>
  </form>

  <p class="hint">Paste a URL with or without <code>https://</code> to create a short <code>mona-</code> slug.</p>
  <p id="bookmark-status" class="status" role="status" aria-live="polite"></p>

  <p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

  <div id="list-header" class="list-header" hidden>
    <h2 class="list-title">Saved bookmarks</h2>
    <button id="clear-all" type="button" class="clear">Clear all</button>
  </div>

  <ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>
</section>

<script>
  import { formatBookmark, generateSlug, loadBookmarks, normalizeUrl } from '../lib/bookmarks.js';

  const storageKey = 'mona-bookmarks';
  const form = document.querySelector<HTMLFormElement>('#add-bookmark');
  const input = document.querySelector<HTMLInputElement>('#url');
  const list = document.querySelector<HTMLUListElement>('#bookmark-list');
  const emptyState = document.querySelector<HTMLParagraphElement>('#empty-state');
  const listHeader = document.querySelector<HTMLDivElement>('#list-header');
  const status = document.querySelector<HTMLParagraphElement>('#bookmark-status');
  const clearButton = document.querySelector<HTMLButtonElement>('#clear-all');

  function getSavedBookmarks() {
    try {
      return loadBookmarks(window.localStorage.getItem(storageKey));
    } catch {
      return [];
    }
  }

  let bookmarks = getSavedBookmarks();

  function announce(message) {
    if (status) status.textContent = message;
  }

  function persist(nextBookmarks) {
    try {
      window.localStorage.setItem(storageKey, JSON.stringify(nextBookmarks));
      return true;
    } catch {
      announce('This browser could not save the bookmarks. They will remain until you leave this page.');
      return false;
    }
  }

  function render() {
    if (!list || !emptyState || !listHeader) return;
    list.replaceChildren();

    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copyButton = document.createElement('button');
      copyButton.className = 'copy';
      copyButton.type = 'button';
      copyButton.textContent = 'Copy';
      copyButton.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          announce(`Copied ${bookmark.slug} to the clipboard.`);
        } catch {
          announce('Could not access the clipboard. Select and copy the slug instead.');
        }
      });

      item.append(link, document.createTextNode(' :: '), slug, copyButton);
      list.append(item);
    }

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    try {
      const url = normalizeUrl(input?.value ?? '');
      const bookmark = { url, slug: generateSlug(bookmarks) };
      const nextBookmarks = [...bookmarks, bookmark];
      bookmarks = nextBookmarks;
      const saved = persist(bookmarks);
      render();
      if (saved) {
        form?.reset();
        announce(`Saved ${formatBookmark(bookmark)}.`);
      }
    } catch {
      announce('Enter a valid web address, such as example.com.');
    }
  });

  clearButton?.addEventListener('click', () => {
    try {
      if (!window.confirm('Clear all saved bookmarks?')) return;
      bookmarks = [];
      const saved = persist(bookmarks);
      render();
      if (saved) announce('All bookmarks cleared.');
    } catch {
      announce('Could not clear the saved bookmarks.');
    }
  });

  render();
</script>

<style>
  .manager {
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: linear-gradient(145deg, color-mix(in srgb, var(--accent) 8%, transparent), transparent 70%);
    box-shadow: 0 1rem 2.5rem color-mix(in srgb, currentColor 8%, transparent);
  }

  form {
    margin-top: 0;
    gap: 0.65rem;
  }

  .field { gap: 0.45rem; }

  input {
    min-height: 2.9rem;
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
    background: color-mix(in srgb, currentColor 3%, transparent);
  }

  form button { min-height: 2.9rem; }

  .hint { margin-bottom: 0.75rem; }

  .status {
    min-height: 1.35rem;
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .list-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0.5rem 0;
  }

  .list-title { margin: 0; font-size: 1rem; font-family: var(--font-head); }
  .clear,
  .copy {
    background: transparent;
    color: inherit;
    border: 1px solid var(--border);
    font-size: 0.8rem;
    font-weight: 500;
  }
  .clear { padding: 0.35rem 0.7rem; }
  .copy { padding: 0.3rem 0.6rem; }
  .clear:hover,
  .copy:hover { border-color: var(--accent); }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.55rem;
  }

  li.bookmark {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.65rem;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: color-mix(in srgb, currentColor 3%, transparent);
  }

  .bookmark .url {
    flex: 1 1 12rem;
    overflow-wrap: anywhere;
    color: inherit;
    text-decoration-color: color-mix(in srgb, var(--accent) 60%, transparent);
    text-underline-offset: 0.2em;
  }

  .bookmark .slug {
    font-family: var(--font-body);
    font-size: 0.85rem;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    color: color-mix(in srgb, var(--accent) 75%, currentColor);
    background: color-mix(in srgb, var(--accent) 16%, transparent);
  }

  .empty {
    margin: 0;
    padding: 1.5rem 1rem;
    text-align: center;
    color: var(--muted);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
  }

  @media (max-width: 30rem) {
    .manager { padding: 1rem; }
    form button { width: 100%; }
  }
</style>
